*.sh text eol=lf

# T5.3: hash-bearing artifacts must be byte-identical across platforms. Every
# recorded split_sha256 / source_probe_sha256 is a hash of the on-disk bytes,
# so a CRLF checkout silently produces different hashes than an LF one.
data/**  text eol=lf
*.jsonl  text eol=lf
*.json   text eol=lf

# Exempt the pinned primary-source PDFs under data/: the rule above would
# otherwise mark them text and corrupt them on checkout.
*.pdf    binary

# R1.6: immutable follow-up snapshots and pinned coordinator scripts retain
# their exact recorded bytes; line-ending conversion would invalidate hashes.
data/eval/m4/gpt6-luna-repeat/** -text
scripts/account_r1_6.py -text
scripts/audit_config4_partial.py -text
scripts/audit_config4_temporal.py -text
scripts/checkpoint_r1_6.py -text
scripts/collect_r1_6_sessions.py -text
scripts/prepare_config4_temporal.py -text
scripts/seal_config4_session.py -text
scripts/seal_config4_temporal_session.py -text
