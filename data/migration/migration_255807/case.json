    "regulation_clause": {
      "doc": "RBI-Commercial-Banks-CC-DC-Directions-2025",
      "clause_id": "31",
      "version": "2025-11-28",
      "effective_date": "2025-11-28",
      "text": "Explicit consent is required to adjust credit (from refund/failed/reversed transactions already paid for) beyond a cut-off of one percent of the credit limit or Rs 5000, whichever is lower; consent sought within 7 days of the credit; on cardholder request, reversal to the bank account within 3 working days.",
      "current_value": {
        "kind": "composite",
        "value": {
          "consent_window": {
            "kind": "duration_days",
            "value": 7,
            "comparator": "at_most",
            "note": null
          },
          "cutoff": {
            "kind": "formula",
            "value": "min(0.01 * credit_limit, 5000_inr)",
            "comparator": null,
            "note": null
          },
          "reversal_window": {
            "kind": "duration_working_days",
            "value": 3,
            "comparator": "at_most",
            "note": null
          }
        },
        "comparator": null,
        "note": null
      }
    },
