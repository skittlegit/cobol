{
  "$defs": {
    "MigrationEvidencePin": {
      "additionalProperties": false,
      "description": "Contained path and exact hash for an external migration artifact.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "MigrationEvidencePin",
      "type": "object"
    },
    "StageIssueEvidence": {
      "additionalProperties": false,
      "properties": {
        "pin": {
          "$ref": "#/$defs/MigrationEvidencePin"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "pin",
        "quote"
      ],
      "title": "StageIssueEvidence",
      "type": "object"
    },
    "StageReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "pre_generation_blocker",
            "scope_limitation",
            "post_patch_validation_obligation",
            "historical_evidence_qualification"
          ],
          "title": "Category",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/StageIssueEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "inherited_issue_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inherited Issue Index"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "category",
        "text",
        "rationale",
        "evidence"
      ],
      "title": "StageReviewIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability_judgment": {
      "minLength": 1,
      "title": "Capability Judgment",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "classification_disagreements_resolved": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Classification Disagreements Resolved",
      "type": "array"
    },
    "decision": {
      "enum": [
        "include",
        "exclude",
        "needs_revision"
      ],
      "title": "Decision",
      "type": "string"
    },
    "duplicate_source_judgment": {
      "minLength": 1,
      "title": "Duplicate Source Judgment",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/MigrationEvidencePin"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "historical_evidence_qualifications": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StageReviewIssue"
      },
      "title": "Historical Evidence Qualifications",
      "type": "array"
    },
    "inherited_issue_classifications": {
      "items": {
        "$ref": "#/$defs/StageReviewIssue"
      },
      "title": "Inherited Issue Classifications",
      "type": "array"
    },
    "intended_fixture_judgment": {
      "minLength": 1,
      "title": "Intended Fixture Judgment",
      "type": "string"
    },
    "post_patch_validation_obligations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StageReviewIssue"
      },
      "title": "Post Patch Validation Obligations",
      "type": "array"
    },
    "pre_generation_blockers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StageReviewIssue"
      },
      "title": "Pre Generation Blockers",
      "type": "array"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "regression_fixture_judgment": {
      "minLength": 1,
      "title": "Regression Fixture Judgment",
      "type": "string"
    },
    "role": {
      "enum": [
        "ai_primary",
        "independent_ai_verifier",
        "ai_adjudicator"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "migration-stage-review-response-v1",
      "default": "migration-stage-review-response-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_judgment": {
      "minLength": 1,
      "title": "Scope Judgment",
      "type": "string"
    },
    "scope_limitations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StageReviewIssue"
      },
      "title": "Scope Limitations",
      "type": "array"
    },
    "unresolved_issues": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unresolved Issues",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "role",
    "decision",
    "rationale",
    "scope_judgment",
    "intended_fixture_judgment",
    "regression_fixture_judgment",
    "capability_judgment",
    "duplicate_source_judgment",
    "evidence",
    "inherited_issue_classifications"
  ],
  "title": "StageReviewResponse",
  "type": "object"
}
