VISION.\\n    4 | EXEC CICS RETURN END-EXEC.\\n    5 > STOP RUN.<EOF>\\nprog.cbl:5: error: invalid indicator 'U' at column 7\\nprog.cbl:6: warning: PROGRAM-ID header missing [-Wothers]\\n    4 | EXEC CICS RETURN END-EXEC.\\n    5 | STOP RUN.<EOF>\\nprog.cbl:6: note: PROGRAM-ID header assumed [-Wothers]\\n\",\n  \"exit_code\": null,\n  \"timed_out\": false\n}", "type": "text"}], "isError": false, "meta": null, "structuredContent": {"compiled_ok": false, "exit_code": null, "stderr": "prog.cbl:1: error: invalid indicator 'F' at column 7\n    1 > IDENTIFICATION DIVISION.\n    2 | PROGRAM-ID. CICSCASE.\n    3 | PROCEDURE DIVISION.\nprog.cbl:2: error: invalid indicator 'M' at column 7\n    1 | IDENTIFICATION DIVISION.\n    2 > PROGRAM-ID. CICSCASE.\n    3 | PROCEDURE DIVISION.\n    4 | EXEC CICS RETURN END-EXEC.\nprog.cbl:3: error: invalid indicator 'U' at column 7\n    1 | IDENTIFICATION DIVISION.\n    2 | PROGRAM-ID. CICSCASE.\n    3 > PROCEDURE DIVISION.\n    4 | EXEC CICS RETURN END-EXEC.\n    5 | STOP RUN.<EOF>\nprog.cbl:4: error: invalid indicator 'I' at column 7\n    2 | PROGRAM-ID. CICSCASE.\n    3 | PROCEDURE DIVISION.\n    4 > EXEC CICS RETURN END-EXEC.\n    5 | STOP RUN.<EOF>\nprog.cbl:5: warning: line not terminated by a newline [-Wmissing-newline]\n    3 | PROCEDURE DIVISION.\n    4 | EXEC CICS RETURN END-EXEC.\n    5 > STOP RUN.<EOF>\nprog.cbl:5: error: invalid indicator 'U' at column 7\nprog.cbl:6: warning: PROGRAM-ID header missing [-Wothers]\n    4 | EXEC CICS RETURN END-EXEC.\n    5 | STOP RUN.<EOF>\nprog.cbl:6: note: PROGRAM-ID header assumed [-Wothers]\n", "stdout": "", "timed_out": false}}, "search_regulations": {"content": [{"annotations": null, "meta": null, "text": "{\n  \"clause\": {\n    \"doc\": \"RBI-Commercial-Banks-CC-DC-Directions-2025\",\n    \"clause_id\": \"19\",\n    \"version\": \"2025-11-28\",\n    \"effective_date\": \"2025-11-28\",\n    \"text\": \"Closure requests must be honoured within 7 working days (subject to dues); failure incurs a penalty of Rs 500 per calendar day of delay until closure, provided no outstanding.\",\n    \"current_value\": {\n      \"kind\": \"composite\",\n      \"value\": {\n        \"closure_window\": {\n          \"kind\": \"duration_working_days\",\n          \"value\": 7,\n          \"comparator\": \"at_most\",\n          \"note\": null\n        },\n        \"penalty_per_day\": {\n          \"kind\": \"amount_inr\",\n          \"value\": 500,\n          \"comparator\": \"at_least\",\n          \"note\": \"Floor: minimum penalty the bank owes per calendar day. Stale side is DOWN (1-2-5 ladder: 500 -> 200) - an un-updated older rule pays the customer less. This leaf is why BL-15 exists; comparator now declared, never inferred.\"\n        },\n        \"day_basis\": {\n          \"kind\": \"enum_set\",\n          \"value\": [\n            \"calendar_day\"\n          ],\n          \"comparator\": null,\n          \"note\": null\n        }\n      },\n      \"comparator\": null,\n      \"note\": null\n    }\n  },\n  \"score\": 9.11500358581543\n}", "type": "text"}, {"annotations": null, "meta": null, "text": "{\n  \"clause\": {\n    \"doc\": \"RBI-Commercial-Banks-CC-DC-Directions-2025\",\n    \"clause_id\": \"11(6)\",\n    \"version\": \"2025-11-28\",\n    \"effective_date\": \"2025-11-28\",\n    \"text\": \"If a credit card is not activated within 30 days of issuance, the issuer must seek OTP-based consent; absent consent, the account must be closed without cost within 7 working days of seeking confirmation.\",\n    \"current_value\": {\n      \"kind\": \"composite\",\n      \"value\": {\n        \"activation_window\": {\n          \"kind\": \"duration_days\",\n          \"value\": 30,\n          \"comparator\": \"at_most\",\n          \"note\": null\n        },\n        \"closure_window\": {\n          \"kind\": \"duration_working_days\",\n          \"value\": 7,\n          \"comparator\": \"at_most\",\n          \"note\": null\n        }\n      },\n      \"comparator\": null,\n      \"note\": null\n    }\n  },\n  \"score\": 7.38902473449707\n}", "type": "text"}, {"annotations": null, "meta": null, "text": "{\n  \"clause\": {\n    \"doc\": \"RBI-Commercial-Banks-CC-DC-Directions-2025\",\n    \"clause_id\": \"20\",\n    \"version\": \"2025-11-28\",\n    \"effective_date\": \"2025-11-28\",\n    \"text\": \"If a card is unused for more than one year, initiate closure after intimating the cardholder; if no reply within 30 days, close the account (subject to dues) and update the CIC within 30 days.\",\n    \"current_value\": {\n      \"kind\": \"composite\",\n      \"value\": {\n        \"inactivity_threshold\": {\n          \"kind\": \"duration_years\",\n          \"value\": 1,\n          \"comparator\": \"strictly_greater\",\n          \"note\": \"Trigger: closure workflow fires when unused for MORE THAN one year. Stale side is UP (later closure of dormant accounts = laxer).\"\n        },\n        \"reply_window\": {\n          \"kind\": \"duration_days\",\n          \"value\": 30,\n          \"comparator\": \"at_most\",\n          \"note\": null\n        },\n        \"cic_update_window\": {\n          \"kind\": \"duration_days\",\n          \"value\": 30,\n          \"comparator\": \"at_most\",\n          \"note\": null\n        }\n      },\n      \"comparator\": null,\n      \"note\": null\n    }\n  },\n  \"score\": 3.8556652069091797\n}", "type": "text"}, {"annotations": null, "meta": null, "text": "{\n  \"clause\": {\n    \"doc\": \"RBI-Commercial-Banks-CC-DC-Directions-2025\",\n    \"clause_id\": \"31\",\n    \"version\": \"2025-11-28\",\n    \"effective_date\": \"2025-11-28\",\n    \"text\": \"Explicit consent is required to adjust credit (from refund/failed/reversed transactions already paid for) beyond a cut-off of one percent of the credit limit or Rs 5000, whichever is lower; consent sought within 7 days of the credit; on cardholder request, reversal to the bank account within 3 working days.\",\n    \"current_value\": {\n      \"kind\": \"composite\",\n      \"value\": {\n        \"cutoff\": {\n          \"kind\": \"formula\",\n          \"value\": \"min(0.01 * credit_limit, 5000_inr)\",\n          \"comparator\": null,\n          \"note\": null\n        },\n        \"consent_window\": {\n          \"kind\": \"duration_days\",\n          \"value\": 7,\n          \"comparator\": \"at_most\",\n          \"note\": null\n        },\n        \"reversal_window\": {\n          \"kind\": \"duration_working_days\",\n          \"value\": 3,\n          \"comparator\": \"at_most\",\n          \"note\": null\n        }\n      },\n      \"comparator\": null,\n      \"note\": null\n    }\n  },\n  \"score\": -0.41511934995651245\n}", "type": "text"}, {"annotations": null, "meta": null, "text": "{\n  \"clause\": {\n    \"doc\": \"RBI-Commercial-Banks-CC-DC-Directions-2025\",\n    \"clause_id\": \"23(5)\",\n    \"version\": \"2025-11-28\",\n    \"effective_date\": \"2025-11-28\",\n    \"text\": \"A card account may be reported past-due to CICs or levied penal charges only when past due for more than three days; days-past-due and late charges are computed from the payment due date; late charges apply only to the outstanding amount after the due date, not the Total Amount Due.\",\n    \"current_value\": {\n      \"kind\": \"composite\",\n      \"value\": {\n        \"past_due_grace\": {\n          \"kind\": \"duration_days\",\n          \"value\": 3,\n          \"comparator\": \"strictly_greater\",\n          \"note\": null\n        },\n        \"charge_base\": {\n          \"kind\": \"enum_set\",\n          \"value\": [\n            \"outstanding_after_due_date\"\n          ],\n          \"comparator\": null,\n          \"note\": null\n        }\n      },\n      \"comparator\": null,\n      \"note\": null\n    }\n  },\n  \"score\": -5.779639720916748\n}", "type": "text"}], "isError": false, "meta": null, "structuredContent": {"result": [{"clause": {"clause_id": "19", "current_value": {"comparator": n