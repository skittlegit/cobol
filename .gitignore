!data/eval/m5/oracle_slice-rerun/*.jsonl
!data/eval/m5/oracle_slice-rerun/*.manifest.json
!data/eval/m5/oracle_slice-rerun/full/
!data/eval/m5/oracle_slice-rerun/full/*.jsonl
!data/eval/m5/oracle_slice-rerun/full/*.manifest.json
!data/eval/m5/t5.3-completion-summary.json
!data/eval/m5/t5.3-completion-summary.md
